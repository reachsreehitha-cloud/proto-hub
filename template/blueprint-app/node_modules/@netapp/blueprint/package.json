{
  "name": "@netapp/blueprint",
  "version": "0.3.12",
  "description": "Blueprint React components (TypeScript)",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/NetApp/blueprint.git"
  },
  "files": [
    "dist",
    "types/style-imports.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/prototype/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./icons/react": {
      "types": "./dist/icons/react.d.ts",
      "import": "./dist/icons/react.js"
    },
    "./icons/react/*": {
      "types": "./dist/icons/generated/react/*.d.ts",
      "import": "./dist/icons/generated/react/*.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./css": {
      "types": "./types/style-imports.d.ts",
      "import": "./dist/blueprint.css",
      "default": "./dist/blueprint.css"
    },
    "./concept.css": {
      "types": "./types/style-imports.d.ts",
      "import": "./dist/styles/concept.css",
      "default": "./dist/styles/concept.css"
    },
    "./prototype": {
      "types": "./dist/prototype/index.d.ts",
      "import": "./dist/prototype/index.js"
    },
    "./tokens.css": {
      "types": "./types/style-imports.d.ts",
      "import": "./dist/styles/tokens.css",
      "default": "./dist/styles/tokens.css"
    },
    "./layout.css": {
      "types": "./types/style-imports.d.ts",
      "import": "./dist/styles/layout.css",
      "default": "./dist/styles/layout.css"
    },
    "./text-styles.css": {
      "types": "./types/style-imports.d.ts",
      "import": "./dist/styles/text-styles.css",
      "default": "./dist/styles/text-styles.css"
    },
    "./tokens.json": "./dist/tokens/all.json",
    "./agent/index.json": "./dist/agent/agent-docs.json",
    "./agent/manifests/components.json": "./dist/agent/manifests/components.json",
    "./agent/manifests/docs.json": "./dist/agent/manifests/docs.json",
    "./agent/manifests/icons.json": "./dist/agent/manifests/icons.json",
    "./react/components/*": {
      "types": "./dist/react/components/*.d.ts",
      "import": "./dist/react/components/*.js"
    }
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts",
    "build:agent-docs": "node scripts/export-agent-docs.mjs",
    "build:storybook": "storybook build -o storybook-static --loglevel warn",
    "build:storybook:dist": "STORYBOOK_BASE=/storybook/blueprint/ storybook build -o storybook-static --loglevel warn",
    "build:storybook:stage": "STORYBOOK_BASE=/storybook-stage/blueprint/ storybook build -o storybook-static --loglevel warn",
    "build:storybook:visual": "node scripts/build-storybook-visual.mjs",
    "check:colors": "npm run style:compile && npm run build:tokens && node style/dist/validate-colors.js",
    "check:icons": "npm run style:compile && node style/dist/validate-icons.js",
    "check:package-age": "node scripts/check-package-age.mjs",
    "check:package-types": "node scripts/check-package-types.mjs",
    "check:typography": "node scripts/check-typography-guardrail.mjs",
    "check:typography:strict": "node scripts/check-typography-guardrail.mjs --strict",
    "ci": "npm run generate && npm run check:colors && npm run check:icons && npm run build --ignore-scripts && npm run check:package-types && npm run build:storybook --ignore-scripts && npm run build:agent-docs && npm run lint && npm run figma:check && npm run test:unit && npm run test:mcp:sanity",
    "verify": "npm run generate && npm run build --ignore-scripts && npm run build:storybook --ignore-scripts && npm run build:agent-docs && npm run lint && npm run test:unit",
    "dist": "npm run generate && npm run build --ignore-scripts && npm run build:storybook:dist && npm run build:agent-docs && (cd storybook-static && tar czf ../dist.tgz .)",
    "figma:check": "figma connect parse --config config/figma/react.json --dry-run --exit-on-unreadable-files",
    "figma:generate-icons": "node scripts/generate-icons-code-connect.mjs",
    "figma:publish": "npm run figma:publish:react",
    "figma:publish:icons": "npm run figma:publish:react:icons",
    "figma:publish:non-icons": "npm run figma:publish:react:non-icons",
    "figma:publish:react": "figma connect publish --config config/figma/react.json --batch-size 200",
    "figma:publish:react:icons": "figma connect publish --config config/figma/react.icons.json --batch-size 200",
    "figma:publish:react:non-icons": "figma connect publish --config config/figma/react.non-icons.json --batch-size 200",
    "figma:republish": "figma connect unpublish --config config/figma/react.json && npm run figma:publish",
    "style:compile": "tsc -p style/tsconfig.json",
    "build:tokens": "node style/dist/build.js",
    "build:icons": "node style/dist/build-icons.js",
    "generate": "npm run style:compile && npm run build:tokens && npm run build:icons",
    "pull-icons": "npm run style:compile && node style/dist/pull-icons.js",
    "pull-variables": "npm run style:compile && node style/dist/pull-variables.js",
    "push-variables": "npm run style:compile && node style/dist/push-variables.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives && npm run fmt:check",
    "prebuild": "npm run generate",
    "prebuild:storybook": "npm run generate",
    "prebuild:storybook:visual": "npm run generate",
    "prepublishOnly": "npm run build && npm run build:storybook && npm run build:agent-docs",
    "prestorybook": "npm run generate",
    "pretest": "npm run build:storybook",
    "pretest:coverage": "npm run build:storybook && npm run build:agent-docs",
    "pretest:visual": "npm run build:storybook:visual",
    "pretest:visual:update": "npm run build:storybook:visual",
    "stage": "npm run build:storybook:stage && npm run build:agent-docs && (cd storybook-static && tar czf - --no-mac-metadata .) | ssh ${npm_package_config_web_host} \"mkdir -p ${npm_package_config_web_directory}/storybook-stage && cd ${npm_package_config_web_directory}/storybook-stage && rm -rf blueprint && mkdir -p blueprint && tar --warning=no-unknown-keyword -xzf - -C blueprint && (find blueprint -print | xargs chmod g+w) && echo 'Updated https://ux.netapp.com/storybook-stage/blueprint/'\"",
    "storybook": "storybook dev -p 6006 --initial-path /?path=/story/examples-component-gallery--component-gallery",
    "test": "npm run test:unit && npm run test:storybook",
    "test:coverage": "vitest run --coverage",
    "test:mcp:sanity": "npm run sanity --prefix services/mcp",
    "test:storybook": "vitest run --project storybook",
    "test:unit": "vitest run --project react --project node",
    "test:visual": "playwright test -c config/playwright/visual.config.ts",
    "test:visual:check": "npm run test:visual -- --reporter=html",
    "test:visual:update": "playwright test -c config/playwright/visual.config.ts --update-snapshots=all",
    "test:watch": "vitest",
    "visual:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@figma/code-connect": "^2.0.0",
    "@netapp/ux-agent-skills": "^1.0.6",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss-mixins": "^12.1.2",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "19.2.8",
    "react-syntax-highlighter": "^16.1.1",
    "storybook": "10.5.10",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-aria-components": ">=1.17.0",
    "react-dom": ">=18",
    "react-syntax-highlighter": ">=15"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.13",
    "brace-expansion": "5.0.9",
    "electron-to-chromium": "1.5.405",
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "valibot": "1.4.2"
  },
  "config": {
    "figmaTokenFile": "~/.figma-api-token",
    "web": {
      "directory": "/u/hackwort/uxapp/html",
      "host": "cyclortp.rtp.openenglab.netapp.com"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
